      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "sendTo": "={{ $('Edit Fields').item.json.approver_email }}",
        "subject": "=[For review] {{ $('Edit Fields').item.json.workshop_title }}: decision memo",
        "emailType": "html",
        "message": "={{ $('Memo to HTML').item.json.memo_html }}<hr><p><b>Drafted by:</b> {{ $('Memo to HTML').item.json.model_used }} &middot; <b>Run ID:</b> {{ $('Edit Fields').item.json.run_id }}</p><p>An approval request follows in a separate email.</p>",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "6b13d629-4dc8-43ca-822a-70d567559b4b",
      "name": "Ask for approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('Edit Fields').item.json.approver_email }}",
        "subject": "=[Approval needed] {{ $('Edit Fields').item.json.workshop_title }}",
        "message": "=Please review the decision memo for \"{{ $('Edit Fields').item.json.workshop_title }}\" (sent to you in the previous email) and approve or reject it.\n\nGovernance flags:\n{{ ($('Memo to HTML').item.json.extraction.governance_flags || []).map(f => '- ' + f).join('\\n') || '- none' }}\n\nDrafted by: {{ $('Memo to HTML').item.json.model_used }}. Nothing is shared until you approve.",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve memo",
            "disapproveLabel": "Reject"
          }
        },
        "options": {
          "appendAttribution": false
        }
      },
      "webhookId": "7d1c2a4e-5b3f-4e8a-9c61-0f2d8b7a3e02"
    },
    {
      "id": "6dfafb02-44cf-431b-be6f-5bebe644200b",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1d05744c-7f8a-4b9c-a846-0e8c80a44eb6",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "902a3ea9-a32e-4661-a44a-e267a9c1f5a9",
      "name": "Rows – Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        -300
      ],
      "parameters": {
        "jsCode": "const m = $('Memo to HTML').first().json;\nconst e = m.extraction;\nconst createdAt = $('Edit Fields').first().json.created_at;\nreturn (e.actions || []).map(x => ({ json: {\n    run_id: e.run_id,\n    workshop: e.workshop,\n    action: x.action,\n    owner: x.owner ?? 'UNASSIGNED',\n    due_date: x.due_date ?? '',\n    priority: x.priority ?? '',\n    linked_decision: x.linked_decision ?? '',\n    status: 'Open',\n    model_used: e.model_used,\n    created_at: createdAt\n} }));"
      }
    },
    {
      "id": "fb51aef6-539a-45c0-a1c5-83f24bcf1a36",
      "name": "Rows – Risks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        -120
      ],
      "parameters": {
        "jsCode": "const m = $('Memo to HTML').first().json;\nconst e = m.extraction;\nconst createdAt = $('Edit Fields').first().json.created_at;\nreturn (e.risks || []).map(x => ({ json: {\n    run_id: e.run_id,\n    workshop: e.workshop,\n    risk: x.risk,\n    impact: x.impact ?? '',\n    likelihood: x.likelihood ?? '',\n    mitigation: x.mitigation ?? '',\n    owner: x.owner ?? '',\n    source: x.source ?? ''\n} }));"
      }
    },
    {
      "id": "0f3dfd11-6d05-417e-a48a-8849c76c9455",
      "name": "Rows – Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        60
      ],
      "parameters": {
        "jsCode": "const m = $('Memo to HTML').first().json;\nconst e = m.extraction;\nconst createdAt = $('Edit Fields').first().json.created_at;\nreturn (e.decisions || []).map(x => ({ json: {\n    run_id: e.run_id,\n    workshop: e.workshop,\n    decision: x.decision,\n    rationale: x.rationale ?? '',\n    scope: x.scope ?? '',\n    decision_owner: x.decision_owner ?? '',\n    requires_signoff: x.requires_signoff ?? ''\n} }));"
      }
    },
