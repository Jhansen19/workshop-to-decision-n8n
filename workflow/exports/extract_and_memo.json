    },
    {
      "id": "ab7d1a57-4e4b-4b4a-ba01-0d6c705a0f32",
      "name": "Extract",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "text": "={{ $json.transcript }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"workshop_summary\": {\n      \"type\": \"string\"\n    },\n    \"decisions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"decision\": {\n            \"type\": \"string\"\n          },\n          \"rationale\": {\n            \"type\": \"string\"\n          },\n          \"scope\": {\n            \"type\": \"string\"\n          },\n          \"decision_owner\": {\n            \"type\": \"string\"\n          },\n          \"requires_signoff\": {\n            \"type\": \"boolean\"\n          }\n        }\n      }\n    },\n    \"open_issues\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"issue\": {\n            \"type\": \"string\"\n          },\n          \"options_discussed\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"escalate_to\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"actions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"action\": {\n            \"type\": \"string\"\n          },\n          \"owner\": {\n            \"type\": \"string\"\n          },\n          \"due_date\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"priority\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"High\",\n              \"Medium\",\n              \"Low\"\n            ]\n          },\n          \"linked_decision\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"risks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"risk\": {\n            \"type\": \"string\"\n          },\n          \"impact\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"High\",\n              \"Medium\",\n              \"Low\"\n            ]\n          },\n          \"likelihood\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"High\",\n              \"Medium\",\n              \"Low\"\n            ]\n          },\n          \"mitigation\": {\n            \"type\": \"string\"\n          },\n          \"owner\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"stated\",\n              \"inferred\"\n            ]\n          }\n        }\n      }\n    },\n    \"dependencies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"dependent\": {\n            \"type\": \"string\"\n          },\n          \"depends_on\": {\n            \"type\": \"string\"\n          },\n          \"owner\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"workshop_summary\",\n    \"decisions\",\n    \"open_issues\",\n    \"actions\",\n    \"risks\",\n    \"dependencies\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "You are a transformation PMO analyst. You read raw workshop notes from cross-functional\noperating model workshops in a multi-market Nordic retail group and extract a precise,\nstructured record.\n\nRules:\n- A DECISION is only something explicitly agreed in the session. If something was\n  proposed, debated or deferred, it is an OPEN ISSUE, not a decision. If a principle is\n  agreed but a detail is left open, record the decision AND an open issue for the detail.\n- Never invent owners or dates. If not stated, use \"UNASSIGNED\" for owners and null for dates.\n  If someone is asked to own something but hands it back, the owner is whoever finally accepts it.\n- Read the whole transcript. Do not rely on any summary or read-back at the end; it may be incomplete.\n- Flag implied risks as well as stated ones, and mark implied ones \"source\": \"inferred\".\n- Classify each decision's scope as \"Group\", \"Local (<market>)\" or \"Group with local variant\".\n- Capture cross-functional DEPENDENCIES (X cannot happen until Y).\n- The input may be in English, Danish, Swedish, Norwegian or Finnish. Always write the output in English.\n- Use concise, business English. No filler.\n- Output ONLY valid JSON matching the schema."
        }
      }
    },
    {
      "id": "bae178dd-ea34-43a1-942e-9c1aaff5a200",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst d = $json.output ?? $json;\nfor (const k of ['decisions','open_issues','actions','risks','dependencies']) d[k] = d[k] ?? [];\nconst flags = [];\nconst unowned = d.actions.filter(a => !a.owner || a.owner === 'UNASSIGNED').length;\nif (unowned) flags.push(`${unowned} action(s) have no owner`);\nd.risks.filter(r => r.impact === 'High' && r.likelihood === 'High' && !r.mitigation)\n  .forEach(r => flags.push(`High/High risk without mitigation: ${r.risk}`));\nif (d.open_issues.length) flags.push(`${d.open_issues.length} open issue(s) need escalation`);\nreturn [{ json: { ...d, governance_flags: flags, model_used: input.model, run_id: input.run_id,\n  workshop: input.workshop_title, workshop_date: input.workshop_date, markets: input.markets } }];"
      }
    },
    {
      "id": "2a788000-0ca9-4549-81be-ef10a012b22c",
      "name": "Memo",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        800,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Write a one-page decision memo for a senior steering committee, based ONLY on the JSON below.\nStructure (Markdown):\n# <Workshop title>: Decision Memo\n**Date | Markets | Run ID**\n## Bottom line (3 sentences max: what was decided, what needs sign-off, biggest risk)\n## Decisions made (table: Decision | Scope | Owner)\n## Decisions requiring your sign-off (numbered, each with a clear recommendation)\n## Open issues for escalation (options discussed + recommended next step)\n## Key risks & dependencies (top 3 only)\n## Next steps (table: Action | Owner | Due)\n## Governance flags\nTone: crisp, neutral, no jargon, no filler. Write in English. Do not add facts not present in the JSON.\n\nJSON: {{ JSON.stringify($json) }}"
      }
    },
    {
      "id": "4c21bca5-2f0c-445f-a184-7bdaff733164",
      "name": "Package",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
