{
  "type": "object",
  "properties": {
    "workshop_summary": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "decision_owner": {
            "type": "string"
          },
          "requires_signoff": {
            "type": "boolean"
          }
        }
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string"
          },
          "options_discussed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "escalate_to": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "linked_decision": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "mitigation": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "stated",
              "inferred"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependent": {
            "type": "string"
          },
          "depends_on": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "workshop_summary",
    "decisions",
    "open_issues",
    "actions",
    "risks",
    "dependencies"
  ]
}